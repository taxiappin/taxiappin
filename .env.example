# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Secret key used on the server side for AI-powered geocoding and reverse geocoding fallbacks.
GEMINI_API_KEY=

# Production Port & Environment
PORT=3000
NODE_ENV=production

# Database (PostgreSQL) - Optional: If provided, platform automatically synchronizes all data to PostgreSQL
# DATABASE_URL=postgres://username:password@localhost:5432/taxiapp
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Razorpay Payments (Optional for real payment gateway transactions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


