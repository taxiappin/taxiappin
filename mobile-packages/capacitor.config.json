{
  "appId": "com.taxiapp.users",
  "appName": "TaxiApp",
  "webDir": "frontend/dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#FAF7F2",
      "androidScaleType": "CENTER_CROP"
    },
    "Geolocation": {
      "enableHighAccuracy": true
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": "taxiappuser.jks",
      "keystoreAlias": "taxiapp",
      "releaseType": "AAB"
    }
  },
  "ios": {
    "contentInset": "always",
    "preferredContentMode": "mobile",
    "scheme": "TaxiApp"
  }
}