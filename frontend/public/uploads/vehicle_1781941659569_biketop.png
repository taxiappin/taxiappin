<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Shadow -->
  <rect x="26" y="8" width="12" height="48" rx="6" fill="#000000" fill-opacity="0.25" filter="blur(3px)"/>
  <!-- Wheels -->
  <rect x="28" y="10" width="8" height="10" rx="3" fill="#1E293B"/>
  <rect x="28" y="44" width="8" height="10" rx="3" fill="#1E293B"/>
  <!-- Frame Line -->
  <rect x="30" y="18" width="4" height="28" fill="#E11D48" stroke="#1E293B" stroke-width="2"/>
  <!-- Handlebars -->
  <rect x="18" y="18" width="28" height="4" rx="2" fill="#1E293B"/>
  <!-- Helmet / Rider Top View -->
  <circle cx="32" cy="31" r="9" fill="#F43F5E" stroke="#1E293B" stroke-width="3"/>
  <rect x="29" y="24" width="6" height="3" rx="1" fill="#1E293B"/>
</svg>
